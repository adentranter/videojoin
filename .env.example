# Postgres (prod: tranter-bris3 over WireGuard, e.g. postgresql://thankyou:PASSWORD@10.66.0.1:5432/thankyou)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thankyou

# https://uploadthing.com/dashboard → API Keys → copy the token
UPLOADTHING_TOKEN=

# Password for /admin
ADMIN_PASSWORD=change-me

# Optional: cookie signing secret (defaults to a hash of ADMIN_PASSWORD)
# SESSION_SECRET=
